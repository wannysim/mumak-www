{
  "name": "blog",
  "version": "1.25.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "PORTLESS_PORT=1355 PORTLESS_HTTPS=0 portless run --name blog.mumak next dev",
    "build": "next build",
    "build:analyze": "ANALYZE=true next build",
    "start": "next start --port 3002",
    "start:e2e": "node scripts/start-e2e.mjs",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check-types": "node ../../node_modules/typescript-go/bin/tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest watch --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:ci": "vitest run --project unit --coverage",
    "test:static": "vitest run --project static",
    "test:e2e": "sh ../../scripts/playwright-e2e.sh",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "clean": "rm -rf .next .turbo coverage test-results playwright-report node_modules/.cache",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:garden": "node --experimental-strip-types scripts/validate-garden.ts",
    "validate:design": "node scripts/validate-design-system.mjs",
    "storybook": "storybook dev --host 127.0.0.1 --port 6006 --no-open",
    "build-storybook": "storybook build",
    "test:focus": "playwright test --config stories/playwright.config.ts",
    "test:storybook": "playwright test --config stories/playwright.config.ts",
    "test:storybook:vitest": "vitest run --project storybook"
  },
  "dependencies": {
    "@mumak/ui": "workspace:*",
    "@sentry/nextjs": "^11.17.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.79.0",
    "marked": "^18.3.0",
    "next": "^16.4.6",
    "next-intl": "^4.16.1",
    "next-mdx-remote-client": "^2.1.12",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-force-graph-3d": "^1.29.2",
    "rehype-prism-plus": "^2.0.2",
    "remark-gfm": "^4.0.1",
    "swr": "^2.5.1",
    "three": "^0.187.0",
    "three-spritetext": "^1.10.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@mumak/playwright-config": "workspace:*",
    "@mumak/typescript-config": "workspace:*",
    "@next/bundle-analyzer": "^16.4.6",
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "10.6.8",
    "@storybook/addon-vitest": "10.6.8",
    "@storybook/nextjs-vite": "10.6.8",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser": "5.1.1",
    "@vitest/browser-playwright": "5.1.1",
    "@vitest/coverage-v8": "^5.1.1",
    "jsdom": "^26.1.0",
    "playwright": "1.63.0",
    "storybook": "10.6.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
