{
  "name": "blog",
  "version": "1.22.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "PORTLESS_PORT=1355 PORTLESS_HTTPS=0 portless run --name blog.mumak next dev",
    "build": "next build",
    "build:analyze": "ANALYZE=true next build",
    "start": "next start --port 3002",
    "start:e2e": "node scripts/start-e2e.mjs",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check-types": "node ../../node_modules/typescript-go/bin/tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:static": "jest --ci --watchAll=false --testPathIgnorePatterns '/node_modules/' --roots '<rootDir>/__tests__/build'",
    "test:e2e": "sh ../../scripts/playwright-e2e.sh",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "clean": "rm -rf .next .turbo coverage test-results playwright-report node_modules/.cache",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:garden": "node --experimental-strip-types scripts/validate-garden.ts",
    "validate:design": "node scripts/validate-design-system.mjs"
  },
  "dependencies": {
    "@mumak/ui": "workspace:*",
    "@sentry/nextjs": "^10.69.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.49.0",
    "marked": "^18.0.14",
    "next": "^16.3.8",
    "next-intl": "^4.14.8",
    "next-mdx-remote-client": "^2.1.12",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-force-graph-3d": "^1.29.2",
    "rehype-prism-plus": "^2.0.2",
    "remark-gfm": "^4.0.1",
    "swr": "^2.5.1",
    "three": "^0.186.1",
    "three-spritetext": "^1.10.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@mumak/playwright-config": "workspace:*",
    "@mumak/typescript-config": "workspace:*",
    "@next/bundle-analyzer": "^16.3.8",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "typescript": "^7.0.2"
  }
}
