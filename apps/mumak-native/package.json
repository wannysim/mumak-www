{
  "name": "mumak-native",
  "version": "1.25.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "PORTLESS_PORT=1355 PORTLESS_HTTPS=0 portless run --name native.mumak expo start",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --check .",
    "format:check": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "check-types": "node ../../node_modules/typescript-go/bin/tsc --noEmit",
    "test:ci": "jest --ci --coverage",
    "export:web": "expo export --platform web --output-dir dist",
    "serve:web": "serve dist --listen 3003 --no-port-switching",
    "preview:e2e": "pnpm export:web && pnpm serve:web",
    "test:e2e": "sh ../../scripts/playwright-e2e.sh",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:native": "maestro test maestro/",
    "verify": "pnpm check-types && pnpm lint && pnpm format:check && pnpm test:ci && pnpm export:web",
    "build": "echo 'mumak-native: native build is delegated to EAS' && exit 0",
    "clean": "rm -rf .expo .turbo coverage dist node_modules/.cache"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@mumak/shared": "workspace:*",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@mumak/playwright-config": "workspace:*",
    "@mumak/typescript-config": "workspace:*",
    "@playwright/test": "1.63.0",
    "@react-native/jest-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.15",
    "react-test-renderer": "19.3.1",
    "serve": "^14.2.8",
    "typescript": "^6.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "react",
        "react-dom"
      ]
    }
  }
}
