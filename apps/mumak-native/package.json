{
  "name": "mumak-native",
  "version": "1.6.2",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "reset-project": "node ./scripts/reset-project.js",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --check .",
    "format:check": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "check-types": "tsc --noEmit",
    "test:ci": "jest --ci --coverage --passWithNoTests",
    "build": "echo 'mumak-native: native build is delegated to EAS' && exit 0",
    "clean": "rm -rf .expo .turbo coverage node_modules/.cache"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@mumak/shared": "workspace:*",
    "expo": "~56.0.5",
    "expo-constants": "~56.0.16",
    "expo-font": "~56.0.5",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.9",
    "expo-linking": "~56.0.12",
    "expo-router": "~56.2.7",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.5",
    "expo-system-ui": "~56.0.5",
    "expo-web-browser": "~56.0.5",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.2",
    "react-native-reanimated": "~4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.25.2",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3"
  },
  "devDependencies": {
    "@mumak/typescript-config": "workspace:*",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.10",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.4",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  }
}
