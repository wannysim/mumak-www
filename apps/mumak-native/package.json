{
  "name": "mumak-native",
  "version": "1.14.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "PORTLESS_PORT=1355 PORTLESS_HTTPS=0 portless run --name native.mumak expo start",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --check .",
    "format:check": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "check-types": "node ../../node_modules/typescript-go/bin/tsc --noEmit",
    "test:ci": "jest --ci --coverage",
    "export:web": "expo export --platform web --output-dir dist",
    "serve:web": "serve dist --listen 3003 --no-port-switching",
    "preview:e2e": "pnpm export:web && pnpm serve:web",
    "test:e2e": "sh ../../scripts/playwright-e2e.sh",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:native": "maestro test maestro/",
    "verify": "pnpm check-types && pnpm lint && pnpm format:check && pnpm test:ci && pnpm export:web",
    "build": "echo 'mumak-native: native build is delegated to EAS' && exit 0",
    "clean": "rm -rf .expo .turbo coverage dist node_modules/.cache"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@mumak/shared": "workspace:*",
    "expo": "~57.0.8",
    "expo-constants": "~57.0.7",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.8",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "~4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.11.3"
  },
  "devDependencies": {
    "@mumak/playwright-config": "workspace:*",
    "@mumak/typescript-config": "workspace:*",
    "@playwright/test": "1.61.0",
    "@react-native/jest-preset": "0.86.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.2",
    "react-test-renderer": "19.2.3",
    "serve": "^14.2.6",
    "typescript": "^6.0.3"
  }
}
