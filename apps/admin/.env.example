# Local origin only. Set the private production hostname in Portainer, never here.
MEDIA_ADMIN_ORIGIN=http://admin.mumak.localhost:1355

# SHA-256 hex digest of a 256-bit random bearer token. Never commit the token itself.
MEDIA_ADMIN_TOKEN_SHA256=

# Runtime storage bind mount. Public URLs are permanently fixed to img.wannysim.com.
MEDIA_ROOT=/data/images

# Confirm this against the production filesystem before deployment (20 GiB candidate).
MEDIA_MIN_FREE_BYTES=21474836480
MEDIA_UPLOAD_TIMEOUT_MS=120000
