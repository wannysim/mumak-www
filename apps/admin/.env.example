# Exact browser origin. Production values and credentials belong in Vercel.
# The private bucket CORS allows the production origin only, so a local origin cannot
# complete the direct browser PUT until it is added to the bucket. See README.md.
MEDIA_ADMIN_ORIGIN=http://admin.mumak.localhost:1355

# SHA-256 hex digest of a 256-bit random bearer token. Never commit the token itself.
MEDIA_ADMIN_TOKEN_SHA256=

# Independent 256-bit signing secret (64 hex characters). Keep outside Git.
MEDIA_ADMIN_SESSION_SECRET=

# Object Read & Write credentials restricted to these two R2 buckets.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=mumak-www-public
R2_PRIVATE_BUCKET=mumak-www-private
