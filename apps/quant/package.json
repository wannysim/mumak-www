{
  "name": "quant",
  "version": "1.21.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "PORTLESS_PORT=1355 PORTLESS_HTTPS=0 portless run --name quant.mumak vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check-types": "node ../../node_modules/typescript-go/bin/tsc --noEmit",
    "preview": "vite preview --port 3007",
    "preview:e2e": "node scripts/preview-e2e.mjs",
    "test": "vitest --watch=false",
    "test:watch": "vitest --watch",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage && pnpm test:paper",
    "test:paper": "python3 -B -m unittest discover -s scripts -p 'test_*.py' -v",
    "test:e2e": "sh ../../scripts/playwright-e2e.sh",
    "test:e2e:ui": "playwright test --ui",
    "clean": "rm -rf dist .turbo coverage test-results playwright-report node_modules/.cache"
  },
  "dependencies": {
    "@mumak/ui": "workspace:*",
    "@supabase/supabase-js": "^2.116.0",
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.41.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@mumak/playwright-config": "workspace:*",
    "@mumak/typescript-config": "workspace:*",
    "@playwright/test": "1.61.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "jsdom": "^29.1.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
