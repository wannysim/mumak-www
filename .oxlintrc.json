{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "oxc", "unicorn", "react"],
  "jsPlugins": [
    {
      "name": "turbo",
      "specifier": "eslint-plugin-turbo"
    }
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "options": {
    "reportUnusedDisableDirectives": "warn"
  },
  "ignorePatterns": [
    "node_modules/**",
    ".turbo/**",
    ".next/**",
    "dist/**",
    "out/**",
    "build/**",
    "coverage/**",
    "test-results/**",
    "playwright-report/**",
    "*.tsbuildinfo"
  ],
  "rules": {
    "react/react-in-jsx-scope": "off",
    "no-shadow": "off",
    "unicorn/consistent-function-scoping": "off",
    "no-useless-constructor": "off",
    "turbo/no-undeclared-env-vars": "warn",
    "jsx-a11y/prefer-tag-over-role": "off",
    "react/set-state-in-effect": "warn",
    "react/purity": "warn",
    "react/refs": "warn",
    "react/immutability": "warn",
    "react/use-memo": "warn"
  },
  "overrides": [
    {
      // 테스트 공통 완화. jest/vitest 규칙은 plugin을 켜는 각 앱 override에 둔다
      // (루트 override의 규칙은 루트에서 켜진 plugin에만 적용된다).
      "files": ["**/*.{test,spec}.{ts,tsx,js,jsx}", "**/__tests__/**/*.{ts,tsx,js,jsx}"],
      "rules": {
        "react/set-state-in-effect": "off",
        "react/purity": "off",
        "react/refs": "off",
        "react/immutability": "off",
        "react/use-memo": "off",
        "react/hooks": "off",
        "jsx-a11y/click-events-have-key-events": "off",
        "jsx-a11y/no-static-element-interactions": "off",
        "jsx-a11y/no-noninteractive-element-interactions": "off",
        "jsx-a11y/control-has-associated-label": "off"
      }
    },
    {
      "files": ["**/scripts/**/*.{ts,js,mjs,cjs}"],
      "rules": {
        "unicorn/no-process-exit": "off",
        "no-underscore-dangle": ["warn", { "allow": ["__dirname", "__filename"] }]
      }
    }
  ]
}
