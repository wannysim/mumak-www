{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "cacheMaxSize": "4GB",
  "globalDependencies": ["package.json", "pnpm-lock.yaml", "turbo.json"],
  "globalEnv": ["NODE_ENV", "CI", "VERCEL", "VERCEL_ENV", "EXPO_OS"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      // `.next/dev`는 next dev/Turbopack의 로컬 dev 캐시(빌드 산출물 아님)이며 .next/**에 걸려
      // 캐시 아티팩트를 부풀린다(로컬에서 dev 후 build 시). 빌드 출력이 아니므로 제외한다.
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**", "out/**", "*.tsbuildinfo"],
      "env": ["NEXT_PUBLIC_*", "ANALYZE"],
      "passThroughEnv": [
        "NODE_ENV",
        "E2E_INCLUDE_DRAFT",
        "SPOTIFY_CLIENT_ID",
        "SPOTIFY_CLIENT_SECRET",
        "SPOTIFY_REFRESH_TOKEN"
      ]
    },
    "mumak-native#build": {
      "outputs": []
    },
    "blog#build": {
      // blog는 output: standalone이라 프리렌더 출력(.next/server)이 .next/standalone 안에
      // 한 벌 더 복제된다. 캐시에 같은 산출물이 두 벌 올라가 remote 업로드를 413으로 키운다(#384).
      // E2E는 .next/standalone/apps/blog/server.js만 실행하고(scripts/start-e2e.mjs), top-level
      // .next/server는 `next start`용이라 이 앱의 CI/배포 어디서도 쓰지 않는다. 따라서 캐시
      // outputs에서 top-level `.next/server`만 제외해 산출물을 절반 가까이 줄인다(117.8→65.3MB gz).
      // standalone 복제본은 그대로 캐시되므로 cache-hit 시에도 E2E가 동작한다(로컬 재현 검증함).
      // base build의 outputs를 그대로 두고 `!.next/server/**`만 더한다.
      // blog#build의 outputs는 base build를 상속이 아니라 대체하므로, base에 더한 `!.next/dev/**`도
      // 여기 다시 명시한다(로컬 dev 캐시가 standalone 아티팩트에 섞이지 않게).
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/server/**", "!.next/dev/**"],
      "env": ["NEXT_PUBLIC_*", "ANALYZE"],
      "passThroughEnv": [
        "NODE_ENV",
        "E2E_INCLUDE_DRAFT",
        "SPOTIFY_CLIENT_ID",
        "SPOTIFY_CLIENT_SECRET",
        "SPOTIFY_REFRESH_TOKEN"
      ]
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxlintrc.json"],
      "outputs": []
    },
    "lint:fix": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxlintrc.json"],
      "cache": false
    },
    "//#lint:root": {
      "inputs": [
        "scripts/**/*.{ts,tsx,js,jsx,mjs,cjs,mts,cts}",
        ".cursor/**/*.{ts,tsx,js,jsx,mjs,cjs,mts,cts}",
        ".agents/**/*.{ts,tsx,js,jsx,mjs,cjs,mts,cts}",
        "*.{ts,tsx,js,jsx,mjs,cjs,mts,cts}",
        ".oxlintrc.json"
      ],
      "outputs": []
    },
    "//#lint:root:fix": {
      "inputs": [
        "scripts/**/*.{ts,tsx,js,jsx,mjs,cjs,mts,cts}",
        ".cursor/**/*.{ts,tsx,js,jsx,mjs,cjs,mts,cts}",
        ".agents/**/*.{ts,tsx,js,jsx,mjs,cjs,mts,cts}",
        "*.{ts,tsx,js,jsx,mjs,cjs,mts,cts}",
        ".oxlintrc.json"
      ],
      "cache": false
    },
    "format": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxfmtrc.jsonc"],
      "outputs": []
    },
    "format:fix": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxfmtrc.jsonc"],
      "cache": false
    },
    "format:check": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxfmtrc.jsonc"],
      "outputs": []
    },
    "//#format:root:check": {
      "inputs": [
        "scripts/**",
        ".cursor/**/*.{ts,tsx,js,jsx,mjs,cjs,mts,cts,json,jsonc,json5,yaml,yml,md,mdx}",
        ".agents/**/*.{ts,tsx,js,jsx,mjs,cjs,mts,cts,json,jsonc,json5,yaml,yml,md,mdx}",
        "*.{ts,tsx,js,jsx,mjs,cjs,mts,cts,json,jsonc,json5,yaml,yml,md,mdx,css,scss,less,html}",
        ".oxfmtrc.jsonc"
      ],
      "outputs": []
    },
    "//#format:root:fix": {
      "inputs": [
        "scripts/**",
        ".cursor/**/*.{ts,tsx,js,jsx,mjs,cjs,mts,cts,json,jsonc,json5,yaml,yml,md,mdx}",
        ".agents/**/*.{ts,tsx,js,jsx,mjs,cjs,mts,cts,json,jsonc,json5,yaml,yml,md,mdx}",
        "*.{ts,tsx,js,jsx,mjs,cjs,mts,cts,json,jsonc,json5,yaml,yml,md,mdx,css,scss,less,html}",
        ".oxfmtrc.jsonc"
      ],
      "cache": false
    },
    "check-types": {
      "dependsOn": ["^build", "build"],
      "inputs": ["$TURBO_DEFAULT$", "tsconfig*.json"],
      "outputs": []
    },
    "knip": {
      "inputs": ["$TURBO_DEFAULT$", "knip.config.ts", "**/*.{ts,tsx,js,jsx}"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build", "build"],
      "inputs": ["$TURBO_DEFAULT$", "jest.config.*", "vitest.config.*"],
      "outputs": ["coverage/**"],
      "passThroughEnv": ["SPOTIFY_CLIENT_ID", "SPOTIFY_CLIENT_SECRET", "SPOTIFY_REFRESH_TOKEN"]
    },
    "test:coverage": {
      "dependsOn": ["^build", "build"],
      "inputs": ["$TURBO_DEFAULT$", "jest.config.*", "vitest.config.*"],
      "outputs": ["coverage/**"],
      "passThroughEnv": ["SPOTIFY_CLIENT_ID", "SPOTIFY_CLIENT_SECRET", "SPOTIFY_REFRESH_TOKEN"]
    },
    "test:ci": {
      "dependsOn": ["^build", "build"],
      "inputs": ["$TURBO_DEFAULT$", "jest.config.*", "vitest.config.*"],
      "outputs": ["coverage/**"],
      "env": ["GITHUB_ACTIONS"],
      "passThroughEnv": ["SPOTIFY_CLIENT_ID", "SPOTIFY_CLIENT_SECRET", "SPOTIFY_REFRESH_TOKEN"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", "**/*.{ts,tsx,js,jsx}", "e2e/**/*", "playwright.config.*"],
      "outputs": ["test-results/**", "playwright-report/**"],
      "passThroughEnv": ["PLAYWRIGHT_*", "CI", "SPOTIFY_CLIENT_ID", "SPOTIFY_CLIENT_SECRET", "SPOTIFY_REFRESH_TOKEN"]
    },
    "validate:content": {
      "inputs": ["content/**/*.mdx", "scripts/validate-content.mjs"],
      "outputs": []
    },
    "validate:garden": {
      "inputs": ["content/**/garden/**/*.mdx", "scripts/validate-garden.ts", "src/shared/lib/wikilink/**/*.ts"],
      "outputs": []
    },
    "validate:design": {
      "inputs": ["src/**/*.ts", "src/**/*.tsx", "scripts/validate-design-system.mjs"],
      "outputs": []
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
